{
  "name": "quick-note",
  "productName": "Quick Note",
  "version": "1.1.0",
  "description": "Minimalistic quick note app with global keyboard shortcut for macOS",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "start:debug": "DEBUG=true electron .",
    "pack": "npx @electron/packager . --icon=\"./assets/icons/mac/quick-note.icns\" --out=\"./build\" --overwrite",
    "pack:all": "npx @electron/packager . --icon=\"./assets/icons/mac/quick-note.icns\" --out=\"./build\" --overwrite --all",
    "release": "npm run pack && sudo rm -rf '/Applications/Quick Note.app' && sudo cp -R './build/Quick Note-darwin-arm64/Quick Note.app' '/Applications/Quick Note.app' && echo '✅ Quick Note zainstalowany w /Applications'",
    "clean": "rm -rf build node_modules",
    "reinstall": "npm run clean && npm install"
  },
  "keywords": [
    "quick",
    "note",
    "electron",
    "productivity",
    "notes",
    "macos",
    "global-shortcut",
    "minimal"
  ],
  "author": {
    "name": "Wojtek Zieliński"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/quick-note"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.2",
    "electron": "^33.4.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
